{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SSK",
  "type": "object",
  "required": ["pieces"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "pieces": {
      "type": "array",
      "items": { "$ref": "#/$defs/piece" }
    },
    "properties": { "type": "object" }
  },
  "$defs": {
    "piece": {
      "type": "object",
      "required": ["id", "points", "rotation", "size", "shape"],
      "additionalProperties": false,
      "properties": {
        "id":       { "type": "integer", "minimum": 0 },
        "points":   { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/point" } },
        "rotation": { "$ref": "#/$defs/vector3" },
        "size":     { "$ref": "#/$defs/vector3" },
        "shape":    { "type": "string", "enum": ["circle", "ngon"] },
        "sides":    { "type": "integer", "minimum": 3 },
        "mode":     { "type": "string", "enum": ["add", "subtract"] },
        "affects":  { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "properties": { "type": "object" }
      }
    },
    "point": {
      "type": "object",
      "required": ["x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" },
        "bezier_in":  { "$ref": "#/$defs/vector3" },
        "bezier_out": { "$ref": "#/$defs/vector3" }
      }
    },
    "vector3": {
      "type": "object",
      "required": ["x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    }
  }
}
